{
  "name": "nuxt-template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "pnpm": ">=12.0.0",
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint",
    "spelling": "cspell lint --no-progress '**'",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install && playwright install-deps"
  },
  "dependencies": {
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "4.6.3",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@cspell/dict-de-de": "4.1.3",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.65.0",
    "@vue/test-utils": "2.5.1",
    "cspell": "10.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-format": "2.0.1",
    "happy-dom": "21.0.4",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  }
}
